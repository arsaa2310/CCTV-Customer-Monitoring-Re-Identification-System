# ============================================================
# VisionTrack — Environment Variables
# Copy this file to .env and adjust as needed.
# docker compose automatically loads .env from project root.
# ============================================================

# Application
APP_DEBUG=false
APP_APP_NAME=VisionTrack
APP_APP_VERSION=1.0.0

# Qdrant connection (matches docker-compose service name)
APP_QDRANT_HOST=qdrant
APP_QDRANT_PORT=6333
APP_QDRANT_COLLECTION=person_embeddings

# Storage
CONFIG_DIR=/app/config
STORAGE_DIR=/app/storage

# Model settings
APP_YOLO_MODEL=yolo11n.pt
APP_REID_MODEL=osnet_x1_0
APP_EMBEDDING_DIM=512

# Server
APP_HOST=0.0.0.0
APP_PORT=8000
